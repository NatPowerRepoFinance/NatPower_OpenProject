<%=
  render Primer::OpenProject::PageHeader.new do |header|
    header.with_title { "Land Contract" }
    header.with_breadcrumbs(
      [{ href: project_overview_path(@project.id), text: @project.name },
       { href: project_settings_general_path(@project.id), text: I18n.t("label_project_settings") },
       { href: project_settings_pda_nf_path(@project.id, @pda_nf.id), text: "PDA: #{@pda_nf.code}" },
       { href: project_settings_pda_nf_negotiation_path(@project.id, @pda_nf.id, @land_negotiation.id), text: "Land Negotiation ##{@land_negotiation.id}" },
       "Land Contract ##{@land_contract.id}"]
    )
  end
%>

<div class="generic-form">
  <fieldset class="form--fieldset">
    <legend class="form--fieldset-legend">Land Contract Details</legend>

    <div class="form--field">
      <label class="form--label">ID</label>
      <div class="form--field-container">
        <input type="text" value="<%= @land_contract.id %>" readonly class="form--text-field" />
      </div>
    </div>

    <div class="form--field">
      <label class="form--label">Contract ID</label>
      <div class="form--field-container">
        <input type="text" value="<%= @land_contract.contract_id %>" readonly class="form--text-field" />
      </div>
    </div>

    <div class="form--field">
      <label class="form--label">Contract Type ID</label>
      <div class="form--field-container">
        <input type="text" value="<%= @land_contract.contract_type_id %>" readonly class="form--text-field" />
      </div>
    </div>

    <div class="form--field">
      <label class="form--label">Start Date</label>
      <div class="form--field-container">
        <input type="text" value="<%= @land_contract.start_date&.strftime("%B %d, %Y") %>" readonly class="form--text-field" />
      </div>
    </div>

    <div class="form--field">
      <label class="form--label">Completion Date</label>
      <div class="form--field-container">
        <input type="text" value="<%= @land_contract.completion_date&.strftime("%B %d, %Y") %>" readonly class="form--text-field" />
      </div>
    </div>

    <div class="form--field">
      <label class="form--label">Status</label>
      <div class="form--field-container">
        <input type="text" value="<%= h(@land_contract.status) if @land_contract.status.present? %>" readonly class="form--text-field" />
      </div>
    </div>

    <div class="form--field">
      <label class="form--label">Initial Expiry Date</label>
      <div class="form--field-container">
        <input type="text" value="<%= @land_contract.initial_expiry_date&.strftime("%B %d, %Y") %>" readonly class="form--text-field" />
      </div>
    </div>

    <div class="form--field">
      <label class="form--label">Initial Expiry Notice Period Days</label>
      <div class="form--field-container">
        <input type="text" value="<%= @land_contract.initial_expiry_notice_period_days %>" readonly class="form--text-field" />
      </div>
    </div>

    <div class="form--field">
      <label class="form--label">Extension Period</label>
      <div class="form--field-container">
        <input type="text" value="<%= @land_contract.extension_period %>" readonly class="form--text-field" />
      </div>
    </div>

    <div class="form--field">
      <label class="form--label">Long Stop Date</label>
      <div class="form--field-container">
        <input type="text" value="<%= @land_contract.long_stop_date&.strftime("%B %d, %Y") %>" readonly class="form--text-field" />
      </div>
    </div>

    <div class="form--field">
      <label class="form--label">Contract Document Link</label>
      <div class="form--field-container">
        <input type="text" value="<%= h(@land_contract.contract_document_link) if @land_contract.contract_document_link.present? %>" readonly class="form--text-field" />
      </div>
    </div>

    <div class="form--field">
      <label class="form--label">Contract Description</label>
      <div class="form--field-container">
        <input type="text" value="<%= h(@land_contract.contract_description) if @land_contract.contract_description.present? %>" readonly class="form--text-field" />
      </div>
    </div>

    <div class="form--field">
      <%= link_to t(:button_edit),
                  edit_land_contract_project_settings_pda_nf_negotiation_path(@project, @pda_nf, @land_negotiation, @land_contract),
                  class: "button -primary" %>
      <%= link_to t(:button_delete),
                  destroy_land_contract_project_settings_pda_nf_negotiation_path(@project, @pda_nf, @land_negotiation, @land_contract),
                  data: {
                    turbo_method: :delete,
                    turbo_confirm: t(:text_are_you_sure)
                  },
                  class: "button -secondary -with-icon icon-delete" %>
      <%= link_to t(:button_back), project_settings_pda_nf_negotiation_path(@project, @pda_nf, @land_negotiation), class: "button" %>
    </div>
  </fieldset>
</div>

