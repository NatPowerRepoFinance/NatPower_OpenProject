<%=
  render Primer::OpenProject::PageHeader.new do |header|
    header.with_title { "Land Title" }
    header.with_breadcrumbs(
      [{ href: project_overview_path(@project.id), text: @project.name },
       { href: project_settings_general_path(@project.id), text: I18n.t("label_project_settings") },
       { href: project_settings_pda_nf_path(@project.id, @pda_nf.id), text: "PDA: #{@pda_nf.code}" },
       { href: show_land_parcel_project_settings_pda_nf_path(@project.id, @pda_nf.id, land_parcel_id: @land_parcel.id), text: "Land Parcel ##{@land_parcel.id}" },
       "Land Title: #{@land_title.land_title_id}"]
    )
  end
%>

<div class="generic-form">
  <fieldset class="form--fieldset">
    <legend class="form--fieldset-legend">Land Title Details</legend>

    <div class="form--field">
      <label class="form--label">ID</label>
      <div class="form--field-container">
        <input type="text" value="<%= @land_title.id %>" readonly class="form--text-field" />
      </div>
    </div>

    <div class="form--field">
      <label class="form--label">Land Title ID</label>
      <div class="form--field-container">
        <input type="text" value="<%= h(@land_title.land_title_id) %>" readonly class="form--text-field" />
      </div>
    </div>

    <div class="form--field">
      <label class="form--label">Land Registry Title ID</label>
      <div class="form--field-container">
        <input type="text" value="<%= h(@land_title.land_registry_title_id) if @land_title.land_registry_title_id.present? %>" readonly class="form--text-field" />
      </div>
    </div>

    <div class="form--field">
      <label class="form--label">Land Registry ID</label>
      <div class="form--field-container">
        <input type="text" value="<%= @land_title.land_registry_id if @land_title.land_registry_id.present? %>" readonly class="form--text-field" />
      </div>
    </div>

    <div class="form--field">
      <label class="form--label">Land Registry Title Document Link</label>
      <div class="form--field-container">
        <input type="text" value="<%= h(@land_title.land_registry_title_document_link) if @land_title.land_registry_title_document_link.present? %>" readonly class="form--text-field" />
      </div>
    </div>

    <div class="form--field">
      <label class="form--label">Land Registry Title Request Date</label>
      <div class="form--field-container">
        <input type="text" value="<%= @land_title.land_registry_title_request_date&.strftime("%B %d, %Y") if @land_title.land_registry_title_request_date.present? %>" readonly class="form--text-field" />
      </div>
    </div>

    <div class="form--field">
      <%= link_to t(:button_edit),
                  edit_land_title_project_settings_pda_nf_path(@project, @pda_nf, land_parcel_id: @land_parcel.id, land_title_id: @land_title.land_title_id),
                  class: "button -primary" %>
      <%= link_to t(:button_delete),
                  destroy_land_title_project_settings_pda_nf_path(@project, @pda_nf, land_parcel_id: @land_parcel.id, land_title_id: @land_title.land_title_id),
                  data: {
                    turbo_method: :delete,
                    turbo_confirm: t(:text_are_you_sure)
                  },
                  class: "button -secondary -with-icon icon-delete" %>
      <%= link_to t(:button_back), show_land_parcel_project_settings_pda_nf_path(@project, @pda_nf, land_parcel_id: @land_parcel.id), class: "button" %>
    </div>
  </fieldset>
</div>

