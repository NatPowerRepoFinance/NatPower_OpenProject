                                    <td colspan="9">
                                      <% if title_no_str.present? %>
                                        <%= link_to h(title_no_str), 
                                                    land_title_api_project_settings_pda_nf_path(@project, pda_id_for_link, negotiation_id: negotiation_id, title_no: title_no_str),
                                                    style: "color: #0969da; text-decoration: none; font-weight: 500;" %>
                                      <% else %>
                                        <%= h(title_no_str) %>
                                      <% end %>
                                    </td>
                                  </tr>
                                <% end %>
                              <% end %>
                            </tbody>
                          </table>
                        </div>
                      </div>
                    </div>
                  <% elsif land_titles.is_a?(Array) %>
                    <div style="margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid #d0d7de;">
                      <p class="form--field-instructions">No land titles available for this negotiation.</p>
                    </div>
                  <% end %>
                </div>
              <% end %>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <p class="form--field-instructions">No land negotiations returned from the API yet.</p>
      <% end %>
