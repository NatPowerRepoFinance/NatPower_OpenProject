                                    <td><%= number_with_precision(title["totalAcre"] || title["total_acre"], precision: 2) if (title["totalAcre"] || title["total_acre"]).present? %></td>
                                    <td><%= number_with_precision(title["usedAcre"] || title["used_acre"], precision: 2) if (title["usedAcre"] || title["used_acre"]).present? %></td>
                                    <td><%= (title["isDeleted"] || title["is_deleted"]) ? "Yes" : "No" unless (title["isDeleted"] || title["is_deleted"]).nil? %></td>
                                    <td><%= h(title["successRating"] || title["success_rating"]) if (title["successRating"] || title["success_rating"]).present? %></td>
                                    <td>
                                      <% if (title["estimatedCompletion"] || title["estimated_completion"]).present? %>
                                        <% est_date = title["estimatedCompletion"] || title["estimated_completion"] %>
                                        <% parsed_date = begin; Date.parse(est_date.to_s); rescue; nil; end %>
                                        <%= parsed_date ? parsed_date.strftime("%B %d, %Y") : est_date %>
                                      <% end %>
                                    </td>
                                  </tr>
                                <% else %>
                                  <%# Fallback for string/numeric values - make it a link if it's a valid title number %>
                                  <% title_no_str = title.to_s %>
                                  <% pda_id_for_link = @pda_id || params[:pda_id] || @pda_nf&.pda_id || @pda_nf&.id || 0 %>
