<%
  # Get project identifier - prefer @project object, fallback to params
  project_for_routes = @project.present? ? @project : (params[:project_id].present? ? params[:project_id] : nil)
  project_name = @project.present? && @project.respond_to?(:name) ? @project.name : (params[:project_id].present? ? "Project #{params[:project_id]}" : "Project")
  
  # Build PDAs breadcrumb link
  pdas_link = if project_for_routes.present?
    if @pda_id.present? && @project.present?
      by_pda_id_project_settings_pda_nfs_path(@project, pda_id: @pda_id)
    elsif @project.present?
      project_settings_pda_nfs_path(@project)
    else
      project_settings_pda_nfs_path(project_for_routes)
    end
  else
    "#"
  end
  
  # Build PDA breadcrumb if PDA ID is available
  # Check both @pda_id (from controller) and params[:pda_id] (from route)
  pda_id_for_breadcrumb = @pda_id || params[:pda_id]
  pda_breadcrumb = nil
  if pda_id_for_breadcrumb.present? && project_for_routes.present?
    # Try to get PDA code/name from database record if available
    pda_display_name = if @pda_nf.present? && @pda_nf.code.present?
      "PDA: #{@pda_nf.code}"
    elsif pda_id_for_breadcrumb.present?
      "PDA: #{pda_id_for_breadcrumb}"
    else
      "PDA"
    end
    
    pda_breadcrumb = {
      href: by_pda_id_project_settings_pda_nfs_path(project_for_routes, pda_id: pda_id_for_breadcrumb),
      text: pda_display_name
    }
  end
  
  breadcrumbs = if project_for_routes.present?
    crumbs = [
      { href: project_overview_path(project_for_routes), text: project_name },
      { href: project_settings_general_path(project_for_routes), text: I18n.t("label_project_settings") },
      { href: pdas_link, text: "PDAs" }
    ]
    # Add PDA breadcrumb if available
    crumbs << pda_breadcrumb if pda_breadcrumb.present?
    crumbs << "Negotiation ##{@negotiation_id}"
    crumbs
  else
    ["Negotiation ##{@negotiation_id}"]
  end
%>
<%=
  render Primer::OpenProject::PageHeader.new do |header|
    header.with_title { "Negotiation Details" }
    header.with_breadcrumbs(breadcrumbs)
  end
%>

<%# Edit Form Section %>
<% if flash[:error].present? %>
  <div class="flash error">
    <%= flash[:error] %>
  </div>
<% end %>

<div class="generic-form" style="margin-bottom: 2rem;">
  <fieldset class="form--fieldset">
    <legend class="form--fieldset-legend">Edit Negotiation</legend>
    
    <%= labelled_tabular_form_with model: @negotiation_form,
                                   url: (@pda_id.present? ? update_negotiation_by_pda_id_project_settings_pda_nfs_path(@project, pda_id: @pda_id, negotiation_id: @negotiation_id) : update_negotiation_project_settings_pda_nf_path(@project, params[:id], negotiation_id: @negotiation_id)),
                                   method: :patch,
                                   scope: :land_negotiation,
                                   html: { class: "form" } do |f| %>

      <div class="form--field">
        <label class="form--label">PDA ID</label>
        <div class="form--field-container">
          <input type="text" value="<%= @pda_id %>" readonly class="form--text-field" />
        </div>
      </div>

      <div class="form--field -required">
        <%= f.text_field :name,
                          required: true,
                          container_class: "-middle",
                          label: "Name" %>
      </div>

      <div class="form--field">
        <%= f.text_field :friendly_name,
                          container_class: "-middle",
                          label: "Friendly Name" %>
      </div>

      <div class="form--field">
        <%= f.select :negotiation_status,
                      options_for_select(
                        (@status_options || []).map { |status| [status["status"], status["id"]] },
                        @negotiation_form.negotiation_status
                      ),
                      { prompt: "Select Status", container_class: "-middle", label: "Negotiation Status" },
                      {} %>
      </div>

      <div class="form--field">
        <%= f.text_field :success_rating,
                          container_class: "-middle",
                          label: "Success Rating" %>
      </div>

      <div class="form--field">
        <%= f.date_field :estimated_completion,
                          container_class: "-middle",
                          label: "Estimated Completion" %>
      </div>

      <div class="form--field">
        <%= f.submit t(:button_save), class: "button -primary -with-icon icon-checkmark" %>
      </div>
    <% end %>
  </fieldset>
</div>

