<%# Land Titles Section - Collapsible Sections %>
<% if @land_titles_data.present? && @land_titles_data.any? %>
  <div class="generic-form">
    <fieldset class="form--fieldset">
      <legend class="form--fieldset-legend">
        Land Titles & Parcels
      </legend>
      
      <% @land_titles_data.each_with_index do |land_title_item, index| %>
        <% if land_title_item.is_a?(Hash) && land_title_item["landTitle"].is_a?(Hash) %>
          <% land_title = land_title_item["landTitle"] %>
          <% parcels = land_title_item["parcelIds"] || [] %>
          <% title_id = land_title["landTitleId"] %>
          
          <%= render(Primer::OpenProject::CollapsibleSection.new(id: "land-title-#{title_id || index}", display: :block, mb: 3, collapsed: true)) do |section| %>
            <% section.with_title(tag: :h3) do %>
              <div class="land-title-header">
                <span class="land-title-header--primary">
                  Land Title 
                  <% if title_id.present? %>
                    <%# Determine PDA ID for the link - prefer @pda_id, then params, then fallback %>
                    <% pda_id_for_link = @pda_id || params[:pda_id] || 0 %>
                    <% negotiation_id_for_link = @negotiation_id || params[:negotiation_id] %>
                    <%= link_to h(title_id), 
                                land_title_api_project_settings_pda_nf_path(@project, pda_id_for_link, negotiation_id: negotiation_id_for_link, title_no: title_id),
                                style: "color: #0969da; text-decoration: none; font-weight: 500;" %>
                  <% end %>
                </span>
                <% if land_title["negotiationStatus"].present? %>
                  <%= render(Primer::Beta::Label.new(size: :medium, scheme: :warning)) { h(land_title["negotiationStatus"]) } %>
                <% end %>
                <% if parcels.present? && parcels.any? %>
                  <%= render(Primer::Beta::Label.new(size: :medium, scheme: :secondary)) { pluralize(parcels.length, "parcel") } %>
                <% else %>
                  <%= render(Primer::Beta::Label.new(size: :medium, scheme: :secondary)) { "No parcels" } %>
                <% end %>
              </div>
            <% end %>
            
            <% section.with_caption do %>
              <div class="land-title-caption">
                <% if land_title["usedAcre"].present? && land_title["totalAcres"].present? %>
                  <span class="land-title-caption--item">
                    <strong>Acres:</strong> <%= number_with_precision(land_title["usedAcre"], precision: 2) %> / <%= number_with_precision(land_title["totalAcres"], precision: 2) %>
                  </span>
                <% end %>
                <% if land_title["successRating"].present? %>
                  <span class="land-title-caption--item">
                    <strong>Success Rating:</strong> <%= h(land_title["successRating"]) %>
                  </span>
                <% end %>
                <% if land_title["estimatedCompletion"].present? %>
                  <span class="land-title-caption--item">
                    <strong>Est. Completion:</strong>
                    <% if land_title["estimatedCompletion"].is_a?(String) && land_title["estimatedCompletion"].match?(/^\d{4}-\d{2}-\d{2}/) %>
                      <% begin %>
                        <%= Date.parse(land_title["estimatedCompletion"]).strftime("%B %d, %Y") %>
                      <% rescue %>
                        <%= h(land_title["estimatedCompletion"]) %>
                      <% end %>
                    <% else %>
                      <%= h(land_title["estimatedCompletion"]) %>
                    <% end %>
                  </span>
                <% end %>
                <% if land_title["landNegotiationId"].present? %>
                  <span class="land-title-caption--item">
                    <strong>Negotiation ID:</strong> <%= land_title["landNegotiationId"] %>
                  </span>
                <% end %>
              </div>
            <% end %>
            
            <% section.with_collapsible_content do %>
              <% if parcels.present? && parcels.any? %>
                <div class="land-parcels-container">
                  <h4 class="land-parcels-title">Land Parcels</h4>
                  <div class="generic-table--container">
                  <div class="generic-table--results-container">
                      <table class="generic-table land-parcels-table">
                      <colgroup>
                        <col>
                        <col>
                        <col>
                        <col>
                        <col>
                      </colgroup>
                      <thead>
                        <tr>
                          <th>
                            <div class="generic-table--sort-header-outer">
                              <div class="generic-table--sort-header">
                                  <span>Parcel ID</span>
                              </div>
                            </div>
                          </th>
                          <th>
                            <div class="generic-table--sort-header-outer">
                              <div class="generic-table--sort-header">
                                  <span>Object ID</span>
                              </div>
                            </div>
                          </th>
                          <th>
                            <div class="generic-table--sort-header-outer">
                              <div class="generic-table--sort-header">
                                <span>Used Acre</span>
                              </div>
                            </div>
                          </th>
                          <th>
                            <div class="generic-table--sort-header-outer">
                              <div class="generic-table--sort-header">
                                  <span>Total Acre</span>
                              </div>
                            </div>
                          </th>
                          <th>
                            <div class="generic-table--sort-header-outer">
                              <div class="generic-table--sort-header">
                                  <span>Technology</span>
                              </div>
                            </div>
                          </th>
                        </tr>
                      </thead>
                      <tbody>
                        <% parcels.each do |parcel| %>
                          <% if parcel.is_a?(Hash) %>
                              <tr class="land-parcel-row">
                              <td><%= parcel["id"] if parcel["id"].present? %></td>
                                <td><%= parcel["objectid"] if parcel["objectid"].present? %></td>
                              <td>
                                <% if parcel["used_acre"].present? %>
                                  <%= number_with_precision(parcel["used_acre"], precision: 2, delimiter: ',') %>
                                  <% else %>
                                    <span class="form--field-instructions">-</span>
                                <% end %>
                              </td>
                              <td>
                                <% if parcel["total_acre"].present? %>
                                  <%= number_with_precision(parcel["total_acre"], precision: 2, delimiter: ',') %>
                                  <% else %>
                                    <span class="form--field-instructions">-</span>
                                <% end %>
                              </td>
                                <td><%= h(parcel["technology"]) if parcel["technology"].present? %></td>
                            </tr>
                          <% end %>
                        <% end %>
                      </tbody>
                    </table>
                    </div>
                  </div>
                </div>
              <% else %>
                <p class="form--field-instructions">No parcels associated with this land title.</p>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    </fieldset>
  </div>
<% end %>

<%# Land Parcels Section (Flat Array from API) %>
<% if @land_parcels_data.present? && @land_parcels_data.any? %>
  <div class="generic-form">
    <fieldset class="form--fieldset">
      <legend class="form--fieldset-legend">Land Parcels</legend>
      
      <div class="generic-table--container">
        <div class="generic-table--results-container">
          <table class="generic-table">
            <thead>
              <tr>
                <th>ID</th>
                <th>Land Negotiation ID</th>
                <th>Land Title ID</th>
