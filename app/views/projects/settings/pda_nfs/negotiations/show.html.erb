                  <td>
                    <% parcel_title_id = parcel["landTitleId"] || parcel[:landTitleId] || parcel["land_title_id"] || parcel[:land_title_id] %>
                    <% if parcel_title_id.present? %>
                      <% pda_id_for_link = @pda_id || params[:pda_id] || 0 %>
                      <% negotiation_id_for_link = @negotiation_id || params[:negotiation_id] %>
                      <%= link_to h(parcel_title_id), 
                                  land_title_api_project_settings_pda_nf_path(@project, pda_id_for_link, negotiation_id: negotiation_id_for_link, title_no: parcel_title_id),
                                  style: "color: #0969da; text-decoration: none; font-weight: 500;" %>
                    <% end %>
                  </td>
                  <td><%= number_with_precision(parcel["parcelTotalAcre"] || parcel[:parcelTotalAcre] || parcel["parcel_total_acre"] || parcel[:parcel_total_acre] || 0, precision: 2) %></td>
                  <td><%= number_with_precision(parcel["parcelUsedAcre"] || parcel[:parcelUsedAcre] || parcel["parcel_used_acre"] || parcel[:parcel_used_acre] || 0, precision: 2) %></td>
                  <td><%= parcel["objectId"] || parcel[:objectId] || parcel["object_id"] || parcel[:object_id] %></td>
                  <td><%= h(parcel["technology"] || parcel[:technology] || "-") %></td>
                  <td><%= (parcel["isDeleted"] || parcel[:isDeleted] || parcel["is_deleted"] || parcel[:is_deleted]) ? "Yes" : "No" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </fieldset>
  </div>
<% end %>

<%# Contracts Section %>
