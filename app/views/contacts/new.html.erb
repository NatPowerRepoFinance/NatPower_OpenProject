<% html_title t(:label_administration), t(:label_contact_new) %>

<%=
  render(Primer::OpenProject::PageHeader.new) do |header|
    header.with_title { t(:label_contact_new) }
    header.with_breadcrumbs(
      [{ href: admin_index_path, text: t(:label_administration) },
       { href: contacts_path, text: t(:label_contact_plural) },
       t(:label_contact_new)]
    )
  end
%>

<%= labelled_tabular_form_for @contact, url: contacts_path do |f| %>
  <%= render partial: "form", locals: { f: f, contact: @contact } %>
<% end %>

