<%=
  widget_wrapper do
    fields = flattened_gis_data

    if fields.any?
      # Split attributes into three vertical columns using existing grid classes
      content_tag(:div, class: "grid-block") do
        fields.to_a.in_groups(3, nil).each do |group|
          concat(
            content_tag(:div, class: "grid-content medium-4 small-12") do
              content_tag(:div, class: "attributes-map -minimal-keys") do
                group.compact.each do |label, value|
                  next if value.nil? || value == ""

                  concat content_tag(:div, label, class: "attributes-map--key")

                  formatted =
                    if value.is_a?(TrueClass) || value.is_a?(FalseClass)
                      render(Primer::Alpha::ToggleSwitch.new(checked: value, enabled: false, size: :small))
                    else
                      format_value_for_display(map_lookup_value(label, value))
                    end

                  concat content_tag(:div, formatted, class: "attributes-map--value")
                end
              end
            end
          )
        end
      end
    else
      render(Primer::Beta::Text.new(color: :subtle)) { t(".no_data") }
    end
  end
%>
